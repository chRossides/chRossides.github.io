---
import { site, ui, type Lang } from '../i18n/ui';
import { byKey, categoryPath, type CategoryKey } from '../i18n/categories';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].faq;

/** Absolute URL for an answer that points at a product page, or null. */
function answerLink(item: (typeof t.items)[number]): { href: string; label: string } | null {
  if (!('link' in item)) return null;
  return {
    href: categoryPath(byKey(item.link.key as CategoryKey), lang),
    label: item.link.label,
  };
}

// Google allows a small set of HTML tags inside acceptedAnswer.text, including <a>.
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.items.map((i) => {
    const link = answerLink(i);
    const text = link ? `${i.a} <a href="${new URL(link.href, site.domain).href}">${link.label}</a>` : i.a;
    return {
      '@type': 'Question',
      name: i.q,
      acceptedAnswer: { '@type': 'Answer', text },
    };
  }),
};
---

<section id="faq" class="faq">
  <div class="head">
    <p class="kicker">{t.kicker}</p>
    <h2>{t.title}</h2>
  </div>
  <div class="list">
    {t.items.map((i) => (
      <details>
        <summary>
          {i.q}
          <span class="mark" aria-hidden="true"></span>
        </summary>
        <p>
          {i.a}
          {answerLink(i) && <a class="more" href={answerLink(i)!.href}>{answerLink(i)!.label} →</a>}
        </p>
      </details>
    ))}
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .faq {
    padding: 80px var(--pad-x);
    scroll-margin-top: 90px;
  }
  .head {
    text-align: center;
    margin-bottom: 40px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 38px);
    color: var(--navy);
  }
  .list {
    max-width: 760px;
    margin: 0 auto;
  }
  details {
    border-bottom: 1px solid var(--border-soft);
  }
  details:first-child {
    border-top: 1px solid var(--border-soft);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 18px 2px;
    font-size: 16.5px;
    font-weight: 600;
    color: var(--navy);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--orange);
  }
  .mark {
    position: relative;
    width: 14px;
    height: 14px;
    flex: none;
  }
  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--orange);
  }
  .mark::before {
    width: 14px;
    height: 2px;
  }
  .mark::after {
    width: 2px;
    height: 14px;
    transition: transform 0.15s;
  }
  details[open] .mark::after {
    transform: scaleY(0);
  }
  details p {
    padding: 0 2px 20px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 640px;
  }
  .more {
    display: inline-block;
    margin-top: 6px;
    font-weight: 600;
    color: var(--orange);
    white-space: nowrap;
  }
  .more:hover {
    text-decoration: underline;
  }
</style>
