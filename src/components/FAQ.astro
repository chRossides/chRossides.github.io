---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].faq;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<section id="faq" class="faq">
  <div class="head">
    <p class="kicker">{t.kicker}</p>
    <h2>{t.title}</h2>
  </div>
  <div class="list">
    {t.items.map((i) => (
      <details>
        <summary>
          {i.q}
          <span class="mark" aria-hidden="true"></span>
        </summary>
        <p>{i.a}</p>
      </details>
    ))}
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .faq {
    padding: 80px var(--pad-x);
    scroll-margin-top: 90px;
  }
  .head {
    text-align: center;
    margin-bottom: 40px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 38px);
    color: var(--navy);
  }
  .list {
    max-width: 760px;
    margin: 0 auto;
  }
  details {
    border-bottom: 1px solid var(--border-soft);
  }
  details:first-child {
    border-top: 1px solid var(--border-soft);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 18px 2px;
    font-size: 16.5px;
    font-weight: 600;
    color: var(--navy);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    color: var(--orange);
  }
  .mark {
    position: relative;
    width: 14px;
    height: 14px;
    flex: none;
  }
  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--orange);
  }
  .mark::before {
    width: 14px;
    height: 2px;
  }
  .mark::after {
    width: 2px;
    height: 14px;
    transition: transform 0.15s;
  }
  details[open] .mark::after {
    transform: scaleY(0);
  }
  details p {
    padding: 0 2px 20px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 640px;
  }
</style>
