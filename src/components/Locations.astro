---
import { site, telHref, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].locations;
const cards = [
  {
    label: t.shop,
    street: lang === 'el' ? site.addressShop.street : site.addressShop.streetEn,
    cityLine: site.addressShop.cityLine[lang],
    phones: [site.phoneShop],
    map: site.mapShop,
  },
  {
    label: t.factory,
    street: lang === 'el' ? site.addressFactory.street : site.addressFactory.streetEn,
    cityLine: site.addressFactory.cityLine[lang],
    phones: [site.phoneFactory, site.phoneFactory2],
    map: site.mapFactory,
  },
];
---

<section id="contact" class="locations">
  <h2>{t.title}</h2>
  <div class="grid">
    {cards.map((c) => (
      <div class="card">
        <div class="head">
          <div class="label">{c.label}</div>
          <a class="map" href={c.map} target="_blank" rel="noopener">{t.map}</a>
        </div>
        <div class="street">{c.street}</div>
        <div class="detail">
          {c.cityLine}<br />
          {c.phones.map((p, i) => (
            <>
              <a href={telHref(p)}>☎ {p}</a>
              {i < c.phones.length - 1 && <span class="sep"> · </span>}
            </>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .locations {
    padding: 74px var(--pad-x);
    scroll-margin-top: 90px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    color: var(--navy);
    margin-bottom: 28px;
    text-align: center;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .card {
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 30px;
  }
  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 12px;
  }
  .label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--orange);
  }
  .map {
    font-size: 13px;
    font-weight: 600;
  }
  .street {
    font-size: 18px;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 6px;
  }
  .detail {
    font-size: 15px;
    color: var(--ink-muted);
    line-height: 1.7;
  }
</style>
