---
import { site, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].locations;
const cards = [
  {
    label: t.shop,
    street: lang === 'el' ? site.addressShop.street : site.addressShop.streetEn,
    postal: site.addressShop.postal,
    phone: site.phoneShop,
  },
  {
    label: t.factory,
    street: lang === 'el' ? site.addressFactory.street : site.addressFactory.streetEn,
    postal: site.addressFactory.postal,
    phone: site.phoneFactory,
  },
];
---

<section id="contact" class="locations">
  <h2>{t.title}</h2>
  <div class="grid">
    {cards.map((c) => (
      <div class="card">
        <div class="label">{c.label}</div>
        <div class="street">{c.street}</div>
        <div class="detail">
          {c.postal} {lang === 'el' ? 'Λευκωσία' : 'Nicosia'}, {t.country}<br />
          <a href={`tel:${c.phone.replace(/ /g, '')}`}>☎ {c.phone}</a>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .locations {
    padding: 74px var(--pad-x);
    scroll-margin-top: 90px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    color: var(--navy);
    margin-bottom: 28px;
    text-align: center;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
  }
  .card {
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 30px;
  }
  .label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--orange);
    margin-bottom: 12px;
  }
  .street {
    font-size: 18px;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 6px;
  }
  .detail {
    font-size: 15px;
    color: var(--ink-muted);
    line-height: 1.7;
  }
</style>
