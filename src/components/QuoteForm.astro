---
import { site, ui, type Lang } from '../i18n/ui';
import { FORM_ENDPOINT } from '../config';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].quote;
const f = t.form;
---

<section id="quote" class="quote">
  <div class="cols">
    <div class="intro">
      <p class="kicker">{t.kicker}</p>
      <h2>{t.title}</h2>
      <p class="sub">{t.sub}</p>
      <div class="phones">
        <a href={`tel:${site.phoneShop.replace(/ /g, '')}`}>☎ {site.phoneShop}</a><br />
        <a href={`tel:${site.phoneFactory.replace(/ /g, '')}`}>☎ {site.phoneFactory}</a><br />
        <span class="person">{t.contactLabel} {site.contactPerson[lang]}</span>
      </div>
    </div>

    <form
      class="card"
      method="POST"
      action={FORM_ENDPOINT}
      data-quote-form
      data-i18n={JSON.stringify({ submit: f.submit, sending: f.sending, success: f.success, error: f.error })}
    >
      <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="hp" />
      <input type="hidden" name="_subject" value={lang === 'el' ? 'Νέο αίτημα προσφοράς — chrossides.com' : 'New quote request — chrossides.com'} />
      <input type="hidden" name="_language" value={lang} />
      <div class="row two">
        <label>
          <span>{f.name}</span>
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          <span>{f.phone}</span>
          <input type="tel" name="phone" required autocomplete="tel" />
        </label>
      </div>
      <div class="row">
        <label>
          <span>{f.email}</span>
          <input type="email" name="email" autocomplete="email" />
        </label>
      </div>
      <div class="row">
        <label>
          <span>{f.type}</span>
          <select name="product_type">
            {f.types.map((o) => <option>{o}</option>)}
          </select>
        </label>
      </div>
      <div class="row two">
        <label>
          <span>{f.size}</span>
          <input type="text" name="size" placeholder={f.sizePlaceholder} />
        </label>
        <label>
          <span>{f.qty}</span>
          <input type="text" name="quantity" placeholder="1" inputmode="numeric" />
        </label>
      </div>
      <div class="row">
        <label>
          <span>{f.details}</span>
          <textarea name="details" rows="4"></textarea>
        </label>
      </div>
      <button type="submit" class="submit">{f.submit}</button>
      <p class="msg" role="status" hidden></p>
    </form>
  </div>
</section>

<script>
  const forms = document.querySelectorAll<HTMLFormElement>('form[data-quote-form]');
  forms.forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      const msg = form.querySelector<HTMLParagraphElement>('.msg')!;
      const { submit, sending, success, error } = JSON.parse(form.dataset.i18n!);
      btn.disabled = true;
      btn.textContent = sending;
      msg.hidden = true;
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        msg.textContent = success;
        msg.className = 'msg ok';
      } catch {
        msg.textContent = error;
        msg.className = 'msg err';
      } finally {
        msg.hidden = false;
        btn.disabled = false;
        btn.textContent = submit;
      }
    });
  });
</script>

<style>
  .quote {
    background: var(--navy);
    padding: 84px var(--pad-x);
    scroll-margin-top: 90px;
  }
  .cols {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    align-items: start;
  }
  .kicker {
    color: var(--orange-light);
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 3.2vw, 40px);
    color: #fff;
    line-height: 1.05;
    margin-bottom: 20px;
    text-wrap: pretty;
  }
  .sub {
    font-size: 16px;
    line-height: 1.65;
    color: #aab4d4;
    margin-bottom: 30px;
  }
  .phones {
    font-size: 15px;
    line-height: 2.1;
    color: #fff;
    font-weight: 600;
  }
  .phones a {
    color: #fff;
  }
  .phones a:hover {
    color: var(--orange-light);
  }
  .person {
    color: #aab4d4;
    font-weight: 500;
  }
  .card {
    background: #fff;
    border-radius: 14px;
    padding: 34px;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .row {
    margin-bottom: 16px;
  }
  .row.two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  label span {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--ink-muted);
    margin-bottom: 7px;
  }
  input,
  select,
  textarea {
    width: 100%;
    background: #fff;
    border: 1px solid var(--border-input);
    border-radius: 8px;
    height: 44px;
    padding: 0 14px;
    font-family: var(--font-body);
    font-size: 14px;
    color: var(--navy);
  }
  select {
    font-weight: 600;
    padding: 0 12px;
  }
  textarea {
    height: auto;
    padding: 12px 14px;
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--orange);
    outline-offset: -1px;
  }
  .submit {
    width: 100%;
    background: var(--orange);
    color: #fff;
    text-align: center;
    padding: 15px;
    border: 0;
    border-radius: 8px;
    font-weight: 700;
    font-size: 15px;
    font-family: var(--font-display);
    cursor: pointer;
    margin-top: 6px;
  }
  .submit:hover {
    background: var(--orange-dark);
  }
  .submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }
  .msg {
    margin-top: 14px;
    font-size: 14px;
    line-height: 1.5;
    padding: 12px 14px;
    border-radius: 8px;
  }
  .msg.ok {
    background: #eaf7ee;
    color: #19673a;
  }
  .msg.err {
    background: #fdeeee;
    color: #a03030;
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .card {
      padding: 24px;
    }
    .row.two {
      grid-template-columns: 1fr;
    }
  }
</style>
