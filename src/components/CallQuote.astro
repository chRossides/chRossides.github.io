---
import { site, telHref, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].quote;
const cards = [
  { label: t.shopLabel, phones: [site.phoneShop], persons: site.contactPerson[lang] },
  { label: t.factoryLabel, phones: [site.phoneFactory, site.phoneFactory2], persons: site.factoryPersons[lang] },
];
---

<section id="quote" class="quote">
  <div class="cols">
    <div class="intro">
      <p class="kicker">{t.kicker}</p>
      <h2>{t.title}</h2>
      <p class="sub">{t.sub}</p>
      <p class="hint">💡 {t.hint}</p>
    </div>

    <div class="cards">
      {cards.map((c) => (
        <div class="card">
          <div class="label">{c.label}</div>
          <div class="numbers">
            {c.phones.map((p) => (
              <a class="number" href={telHref(p)}>
                <span class="icon">☎</span>
                {p}
              </a>
            ))}
          </div>
          <div class="person">{c.persons}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .quote {
    background: var(--navy);
    padding: 84px var(--pad-x);
    scroll-margin-top: 90px;
  }
  .cols {
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    align-items: center;
  }
  .kicker {
    color: var(--orange-light);
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 3.2vw, 40px);
    color: #fff;
    line-height: 1.05;
    margin-bottom: 20px;
    text-wrap: pretty;
  }
  .sub {
    font-size: 16px;
    line-height: 1.65;
    color: #aab4d4;
    margin-bottom: 24px;
  }
  .hint {
    font-size: 14px;
    line-height: 1.6;
    color: #aab4d4;
    background: rgba(255, 255, 255, 0.07);
    border-radius: 8px;
    padding: 12px 16px;
    display: inline-block;
  }
  .cards {
    display: grid;
    gap: 18px;
  }
  .card {
    background: #fff;
    border-radius: 14px;
    padding: 28px 32px;
  }
  .label {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--orange);
    margin-bottom: 14px;
  }
  .numbers {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 14px;
  }
  .number {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--orange);
    color: #fff;
    font: 700 clamp(17px, 1.6vw, 21px) / 1 var(--font-display);
    letter-spacing: 0.01em;
    padding: 15px 22px;
    border-radius: 8px;
    white-space: nowrap;
  }
  .number:hover {
    background: var(--orange-dark);
    color: #fff;
  }
  .icon {
    font-size: 0.9em;
  }
  .person {
    font-size: 14px;
    color: var(--ink-muted);
  }
  @media (max-width: 900px) {
    .cols {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .card {
      padding: 24px;
    }
    .number {
      width: 100%;
      justify-content: center;
    }
  }
</style>
