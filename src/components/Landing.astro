---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import TrustStrip from './TrustStrip.astro';
import Products from './Products.astro';
import Process from './Process.astro';
import About from './About.astro';
import CallQuote from './CallQuote.astro';
import Locations from './Locations.astro';
import Footer from './Footer.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<Base lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <TrustStrip lang={lang} />
    <Products lang={lang} />
    <Process lang={lang} />
    <About lang={lang} />
    <CallQuote lang={lang} />
    <Locations lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
