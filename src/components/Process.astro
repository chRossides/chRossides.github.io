---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].process;
---

<section id="process" class="process">
  <div class="head">
    <p class="kicker">{t.kicker}</p>
    <h2>{t.title}</h2>
  </div>
  <div class="grid">
    {t.steps.map((s) => (
      <div>
        <div class="num">{s.n}</div>
        <div class="step-t">{s.t}</div>
        <div class="step-d">{s.d}</div>
      </div>
    ))}
  </div>
</section>

<style>
  .process {
    background: var(--bg-soft);
    padding: 80px var(--pad-x);
    scroll-margin-top: 90px;
  }
  .head {
    text-align: center;
    margin-bottom: 52px;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 38px);
    color: var(--navy);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 40px;
  }
  .num {
    font: 800 44px/1 var(--font-display);
    color: var(--orange);
    margin-bottom: 14px;
  }
  .step-t {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    color: var(--navy);
    margin-bottom: 9px;
  }
  .step-d {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-muted);
  }
</style>
