---
import { ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].footer;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="top">
    <div class="brand">
      ROSSIDES<span class="dot">.</span>
      <span class="company">{t.company}</span>
    </div>
  </div>
  <div class="legal">© {year} Charalambos Rossides LTD - {t.tagline}</div>
</footer>

<style>
  .footer {
    background: var(--navy-dark);
    color: #aab4d4;
    padding: 44px var(--pad-x) 32px;
  }
  .top {
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .brand {
    font: 800 20px/1 var(--font-display);
    color: #fff;
  }
  .dot {
    color: var(--orange);
  }
  .company {
    font: 500 13px var(--font-body);
    color: #8a93a3;
  }
  .legal {
    font-size: 12px;
    color: #6b7392;
    padding-top: 16px;
  }
</style>
