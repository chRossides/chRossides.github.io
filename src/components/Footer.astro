---
import { ui, type Lang } from '../i18n/ui';
import { categories, categoryPath } from '../i18n/categories';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].footer;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="top">
    <div class="brand">
      ROSSIDES<span class="dot">.</span>
      <span class="company">{t.company}</span>
    </div>
    <nav class="links" aria-label={t.productsLabel}>
      <h2>{t.productsLabel}</h2>
      <ul>
        {categories.map((c) => (
          <li><a href={categoryPath(c, lang)}>{c.content[lang].title}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="legal">© {year} Charalambos Rossides LTD - {t.tagline}</div>
</footer>

<style>
  .footer {
    background: var(--navy-dark);
    color: #aab4d4;
    padding: 44px var(--pad-x) 32px;
  }
  .top {
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .links {
    margin-top: 26px;
  }
  .links h2 {
    font: 700 12px/1 var(--font-body);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #8a93a3;
    margin-bottom: 14px;
  }
  .links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    font-size: 14px;
    color: #c3cbe4;
  }
  .links a:hover {
    color: #fff;
  }
  .brand {
    font: 800 20px/1 var(--font-display);
    color: #fff;
  }
  .dot {
    color: var(--orange);
  }
  .company {
    font: 500 13px var(--font-body);
    color: #8a93a3;
  }
  .legal {
    font-size: 12px;
    color: #6b7392;
    padding-top: 16px;
  }
</style>
