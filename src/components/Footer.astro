---
import { site, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].footer;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="top">
    <div class="brand">
      ROSSIDES<span class="dot">.</span>
      <span class="company">{t.company}</span>
    </div>
    <div class="info">
      {lang === 'el' ? site.addressShop.street : site.addressShop.streetEn}, {site.addressShop.postal}{' '}
      {site.addressShop.city[lang]} · {lang === 'el' ? site.addressFactory.street : site.addressFactory.streetEn}
      <br />
      {site.phoneShop} · {site.phoneFactory} · {site.contactPerson[lang]}
    </div>
  </div>
  <div class="legal">© {year} Charalambos Rossides LTD — {t.tagline}</div>
</footer>

<style>
  .footer {
    background: var(--navy-dark);
    color: #aab4d4;
    padding: 56px var(--pad-x) 36px;
  }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 32px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    gap: 40px;
    flex-wrap: wrap;
  }
  .brand {
    font: 800 20px/1 var(--font-display);
    color: #fff;
  }
  .dot {
    color: var(--orange);
  }
  .company {
    font: 500 13px var(--font-body);
    color: #8a93a3;
  }
  .info {
    font-size: 14px;
    line-height: 1.8;
    text-align: right;
  }
  .legal {
    font-size: 12px;
    color: #6b7392;
    padding-top: 16px;
  }
  @media (max-width: 720px) {
    .info {
      text-align: left;
    }
  }
</style>
