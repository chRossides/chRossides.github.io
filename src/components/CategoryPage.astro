---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import CallQuote from './CallQuote.astro';
import Footer from './Footer.astro';
import { site, ui, type Lang } from '../i18n/ui';
import { categories, categoryPath, type Category } from '../i18n/categories';
import nationalImg from '../assets/national-flags.jpg';
import heroFlagImg from '../assets/hero-flag.jpg';
import logoImg from '../assets/logo-print.jpg';
import paradeBlueImg from '../assets/parade-banner-blue.jpg';
import paradeBlackImg from '../assets/parade-banner-black.jpg';
import embroideryImg from '../assets/embroidery.jpg';
import machinesImg from '../assets/embroidery-machines.jpg';

interface Props {
  category: Category;
  lang: Lang;
}

const { category, lang } = Astro.props;
const t = category.content[lang];
const nav = ui[lang];

const imagesByKey: Record<Category['key'], ImageMetadata[]> = {
  national: [nationalImg, heroFlagImg],
  logo: [logoImg, heroFlagImg],
  parade: [paradeBlueImg, paradeBlackImg],
  embroidery: [embroideryImg, machinesImg],
};
const images = imagesByKey[category.key];

const path = categoryPath(category, lang);
const altPath = categoryPath(category, lang === 'el' ? 'en' : 'el');
const homeLabel = lang === 'el' ? 'Αρχική' : 'Home';
const productsLabel = nav.nav.products;
const home = lang === 'el' ? '/' : '/en/';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: new URL(home, site.domain).href },
    { '@type': 'ListItem', position: 2, name: productsLabel, item: new URL(`${home}#products`, site.domain).href },
    { '@type': 'ListItem', position: 3, name: t.title, item: new URL(path, site.domain).href },
  ],
};
---

<Base lang={lang} title={t.metaTitle} description={t.metaDescription} path={path} altPath={altPath}>
  <Nav lang={lang} />
  <main>
    <article class="category">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={home}>{homeLabel}</a>
        <span>/</span>
        <a href={`${home}#products`}>{productsLabel}</a>
        <span>/</span>
        <span aria-current="page">{t.title}</span>
      </nav>

      <div class="grid">
        <div class="text">
          <h1>{t.title}</h1>
          {t.intro.map((p) => <p class="body">{p}</p>)}
          <div class="specs">
            <h2>{t.specsTitle}</h2>
            <ul>
              {t.specs.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </div>
        <div class="media">
          {images.map((img, i) => (
            <Image
              src={img}
              alt={`${t.title} ${i + 1}`}
              widths={[480, 760, 1100]}
              sizes="(max-width: 900px) 100vw, 38vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      </div>
    </article>
    <CallQuote lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

<style>
  .category {
    padding: 40px var(--pad-x) 80px;
  }
  .crumbs {
    font-size: 13.5px;
    color: var(--ink-muted);
    display: flex;
    gap: 10px;
    margin-bottom: 34px;
  }
  .crumbs a {
    font-weight: 600;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: start;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(34px, 3.6vw, 48px);
    letter-spacing: -0.02em;
    line-height: 1.04;
    color: var(--navy);
    margin-bottom: 24px;
    text-wrap: pretty;
  }
  .body {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: 16px;
    max-width: 560px;
    text-wrap: pretty;
  }
  .specs {
    margin-top: 30px;
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 24px 28px;
    max-width: 560px;
  }
  .specs h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    color: var(--navy);
    margin-bottom: 12px;
  }
  .specs ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .specs li {
    position: relative;
    padding: 7px 0 7px 22px;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .specs li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 14px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
  }
  .media {
    display: grid;
    gap: 18px;
  }
  .media img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 18px 44px rgba(21, 38, 94, 0.16);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
