---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import CallQuote from './CallQuote.astro';
import Footer from './Footer.astro';
import { site, ui, type Lang } from '../i18n/ui';
import { byKey, categoryPath, type Category } from '../i18n/categories';
import nationalImg from '../assets/national-flags.jpg';
import heroFlagImg from '../assets/hero-flag.jpg';
import logoImg from '../assets/logo-print.jpg';
import paradeBlueImg from '../assets/parade-banner-blue.jpg';
import paradeBlackImg from '../assets/parade-banner-black.jpg';
import embroideryImg from '../assets/embroidery.jpg';
import machinesImg from '../assets/embroidery-machines.jpg';

interface Props {
  category: Category;
  lang: Lang;
}

const { category, lang } = Astro.props;
const t = category.content[lang];
const nav = ui[lang];

// Every page currently reuses the same small stock of workshop photographs.
// Replace these once the family supplies real photography of finished work.
const imagesByKey: Record<Category['key'], ImageMetadata[]> = {
  national: [nationalImg, heroFlagImg],
  logo: [logoImg, heroFlagImg],
  parade: [paradeBlueImg, paradeBlackImg],
  embroidery: [embroideryImg, machinesImg],
  repairs: [paradeBlackImg, embroideryImg],
  parades: [paradeBlueImg, nationalImg],
  school: [paradeBlueImg, paradeBlackImg],
  church: [paradeBlackImg, embroideryImg],
  table: [nationalImg, heroFlagImg],
  poles: [paradeBlueImg, paradeBlackImg],
  bunting: [nationalImg, heroFlagImg],
  sizes: [nationalImg, logoImg],
};
const images = imagesByKey[category.key];

const path = categoryPath(category, lang);
const altPath = categoryPath(category, lang === 'el' ? 'en' : 'el');
const related = category.related.map(byKey);
const homeLabel = lang === 'el' ? 'Αρχική' : 'Home';
const productsLabel = nav.nav.products;
const home = lang === 'el' ? '/' : '/en/';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: new URL(home, site.domain).href },
    { '@type': 'ListItem', position: 2, name: productsLabel, item: new URL(`${home}#products`, site.domain).href },
    { '@type': 'ListItem', position: 3, name: t.title, item: new URL(path, site.domain).href },
  ],
};

// Per-category FAQ. The homepage carries its own FAQPage for the general questions;
// these are product-specific and target the long-tail queries for this category.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<Base lang={lang} title={t.metaTitle} description={t.metaDescription} path={path} altPath={altPath}>
  <Nav lang={lang} />
  <main>
    <article class="category">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={home}>{homeLabel}</a>
        <span>/</span>
        <a href={`${home}#products`}>{productsLabel}</a>
        <span>/</span>
        <span aria-current="page">{t.title}</span>
      </nav>

      <div class="grid">
        <div class="text">
          <h1>{t.title}</h1>
          {t.intro.map((p) => <p class="body">{p}</p>)}
          <div class="specs">
            <h2>{t.specsTitle}</h2>
            <ul>
              {t.specs.map((s) => <li>{s}</li>)}
            </ul>
          </div>
        </div>
        <div class="media">
          {images.map((img, i) => (
            <Image
              src={img}
              alt={`${t.title} ${i + 1}`}
              widths={[480, 760, 1100]}
              sizes="(max-width: 900px) 100vw, 38vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      </div>

      <div class="detail">
        {t.sections.map((s) => (
          <section class="block">
            <h2>{s.heading}</h2>
            {s.body?.map((p) => <p class="body">{p}</p>)}
            {s.table && (
              <div class="tablewrap">
                <table>
                  <thead>
                    <tr>{s.table.columns.map((c) => <th scope="col">{c}</th>)}</tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((row) => (
                      <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {s.bullets && (
              <ul class="points">
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
            {s.footnote && <p class="footnote">{s.footnote}</p>}
          </section>
        ))}

        <section class="block">
          <h2>{t.faqTitle}</h2>
          <div class="faq">
            {t.faq.map((i) => (
              <details>
                <summary>
                  {i.q}
                  <span class="mark" aria-hidden="true"></span>
                </summary>
                <p>{i.a}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="block">
          <h2>{t.relatedTitle}</h2>
          <ul class="related">
            {related.map((c) => (
              <li>
                <a href={categoryPath(c, lang)}>{c.content[lang].title}</a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </article>
    <CallQuote lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .category {
    padding: 40px var(--pad-x) 80px;
  }
  .crumbs {
    font-size: 13.5px;
    color: var(--ink-muted);
    display: flex;
    gap: 10px;
    margin-bottom: 34px;
  }
  .crumbs a {
    font-weight: 600;
  }
  .grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 56px;
    align-items: start;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(34px, 3.6vw, 48px);
    letter-spacing: -0.02em;
    line-height: 1.04;
    color: var(--navy);
    margin-bottom: 24px;
    text-wrap: pretty;
  }
  .body {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: 16px;
    max-width: 560px;
    text-wrap: pretty;
  }
  .specs {
    margin-top: 30px;
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 24px 28px;
    max-width: 560px;
  }
  .specs h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    color: var(--navy);
    margin-bottom: 12px;
  }
  .specs ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .specs li {
    position: relative;
    padding: 7px 0 7px 22px;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .specs li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 14px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
  }
  .detail {
    max-width: 720px;
    margin-top: 64px;
  }
  .block + .block {
    margin-top: 44px;
  }
  .block h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(21px, 2.2vw, 26px);
    letter-spacing: -0.01em;
    color: var(--navy);
    margin-bottom: 14px;
    text-wrap: balance;
  }
  .tablewrap {
    overflow-x: auto;
    margin: 20px 0;
    border: 1px solid var(--border-soft);
    border-radius: 12px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  thead th {
    background: var(--bg-soft);
    text-align: left;
    font-weight: 700;
    font-size: 13.5px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--navy);
    padding: 12px 16px;
    white-space: nowrap;
  }
  tbody th {
    text-align: left;
    font-weight: 700;
    color: var(--navy);
    white-space: nowrap;
  }
  tbody th,
  tbody td {
    padding: 12px 16px;
    vertical-align: top;
    color: var(--ink-soft);
    line-height: 1.55;
    border-top: 1px solid var(--border-soft);
  }
  .points {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    position: relative;
    padding: 6px 0 6px 22px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 13px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
  }
  .footnote {
    margin-top: 14px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-muted);
  }
  .faq details {
    border-bottom: 1px solid var(--border-soft);
  }
  .faq details:first-child {
    border-top: 1px solid var(--border-soft);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 16px 2px;
    font-size: 16px;
    font-weight: 600;
    color: var(--navy);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:hover {
    color: var(--orange);
  }
  .mark {
    position: relative;
    width: 14px;
    height: 14px;
    flex: none;
  }
  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--orange);
  }
  .mark::before {
    width: 14px;
    height: 2px;
  }
  .mark::after {
    width: 2px;
    height: 14px;
    transition: transform 0.15s;
  }
  .faq details[open] .mark::after {
    transform: scaleY(0);
  }
  .faq details p {
    padding: 0 2px 18px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .related {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    background: var(--bg-soft);
    font-size: 15px;
    font-weight: 600;
    color: var(--navy);
  }
  .related a:hover {
    border-color: var(--orange);
    color: var(--orange);
  }
  .media {
    display: grid;
    gap: 18px;
  }
  .media img {
    width: 100%;
    height: auto;
    border-radius: 14px;
    box-shadow: 0 18px 44px rgba(21, 38, 94, 0.16);
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
  }
</style>
