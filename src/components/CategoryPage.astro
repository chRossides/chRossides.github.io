---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import CallQuote from './CallQuote.astro';
import Footer from './Footer.astro';
import { site, ui, type Lang } from '../i18n/ui';
import { byKey, categoryPath, type Category, type CategoryKey } from '../i18n/categories';
import nationalImg from '../assets/national-flags.jpg';
import logoImg from '../assets/logo-print.jpg';
import paradeBlueImg from '../assets/parade-banner-blue.jpg';
import paradeBlackImg from '../assets/parade-banner-black.jpg';
import embroideryImg from '../assets/embroidery.jpg';
import machinesImg from '../assets/embroidery-machines.jpg';

interface Props {
  category: Category;
  lang: Lang;
}

const { category, lang } = Astro.props;
const t = category.content[lang];
const nav = ui[lang];

// Every page currently reuses the same small stock of workshop photographs.
// Replace these once the family supplies real photography of finished work.
const imagesByKey: Record<Category['key'], ImageMetadata[]> = {
  national: [nationalImg],
  logo: [logoImg],
  parade: [paradeBlueImg, paradeBlackImg],
  embroidery: [embroideryImg, machinesImg],
  repairs: [],
  parades: [paradeBlueImg, nationalImg],
  school: [paradeBlueImg, paradeBlackImg],
  table: [],
  poles: [],
  bunting: [],
  sizes: [],
};
const images = imagesByKey[category.key];

/*
 * Frame proportions follow the photographs rather than the other way round.
 * A single image gets its own ratio, so nothing is cropped or letterboxed.
 * A pair shares the group average, so the two sit at a matching height, and
 * the small residual is filled by the blurred backdrop.
 */
const frameRatio =
  images.length === 0 ? 1 : images.reduce((sum, i) => sum + i.width / i.height, 0) / images.length;

/**
 * Body copy supports three inline markers:
 *   [[key|anchor text]]   a link to another product page, resolved per language
 *                         so cross-references survive a slug change
 *   [[https://…|text]]    an external link, opened in a new tab
 *   **bold**              emphasis, for the numbers worth stopping on
 * All render as nodes, never as raw HTML, so copy cannot inject markup.
 */
const INLINE_MARKUP = /\[\[([^|\]]+)\|([^\]]+)\]\]|\*\*([^*]+)\*\*/g;

type Part =
  | { text: string }
  | { href: string; label: string; external: boolean }
  | { bold: string };

function inlineParts(text: string): Part[] {
  const parts: Part[] = [];
  let cursor = 0;
  for (const match of text.matchAll(INLINE_MARKUP)) {
    const at = match.index ?? 0;
    if (at > cursor) parts.push({ text: text.slice(cursor, at) });
    if (match[3] !== undefined) {
      parts.push({ bold: match[3] });
    } else {
      const target = match[1]!;
      const external = target.startsWith('http');
      parts.push({
        href: external ? target : categoryPath(byKey(target as CategoryKey), lang),
        label: match[2]!,
        external,
      });
    }
    cursor = at + match[0].length;
  }
  if (cursor < text.length) parts.push({ text: text.slice(cursor) });
  return parts;
}

const path = categoryPath(category, lang);
const altPath = categoryPath(category, lang === 'el' ? 'en' : 'el');
const related = category.related.map(byKey);
const homeLabel = lang === 'el' ? 'Αρχική' : 'Home';
const productsLabel = nav.nav.products;
const home = lang === 'el' ? '/' : '/en/';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabel, item: new URL(home, site.domain).href },
    { '@type': 'ListItem', position: 2, name: productsLabel, item: new URL(`${home}#products`, site.domain).href },
    { '@type': 'ListItem', position: 3, name: t.title, item: new URL(path, site.domain).href },
  ],
};

// Per-category FAQ. The homepage carries its own FAQPage for the general questions;
// these are product-specific and target the long-tail queries for this category.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<Base lang={lang} title={t.metaTitle} description={t.metaDescription} path={path} altPath={altPath}>
  <Nav lang={lang} altPath={altPath} />
  <main>
    <article class="category">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={home}>{homeLabel}</a>
        <span>/</span>
        <a href={`${home}#products`}>{productsLabel}</a>
        <span>/</span>
        <span aria-current="page">{t.title}</span>
      </nav>

      <header class="lead">
        <h1>{t.title}</h1>
        {t.intro.map((p) => <p class="body">{p}</p>)}
        <div class="specs">
          <h2>{t.specsTitle}</h2>
          <ul>
            {t.specs.map((s) => <li>{s}</li>)}
          </ul>
        </div>
      </header>

      {images.length > 0 && (
        <div class:list={['media', { pair: images.length > 1 }]}>
          {images.map((img, i) => (
            <figure class="frame" style={`--r:${images.length > 1 ? frameRatio : img.width / img.height}`}>
              <div class="backdrop" style={`background-image:url(${img.src})`}></div>
              <Image
                src={img}
                alt={`${t.title} ${i + 1}`}
                widths={[480, 760, 1100]}
                sizes={images.length > 1 ? '(max-width: 820px) 100vw, 370px' : '(max-width: 820px) 100vw, 760px'}
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </figure>
          ))}
        </div>
      )}

      <div class="detail">
        {t.sections.map((s) => (
          <section class="block">
            <h2>{s.heading}</h2>
            {s.body?.map((p) => (
              <p class="body">
                {inlineParts(p).map((part) =>
                  'href' in part ? (
                    <a
                      href={part.href}
                      target={part.external ? '_blank' : undefined}
                      rel={part.external ? 'noopener' : undefined}
                    >
                      {part.label}
                    </a>
                  ) : 'bold' in part ? (
                    <strong>{part.bold}</strong>
                  ) : (
                    part.text
                  )
                )}
              </p>
            ))}
            {s.table && (
              <div class="tablewrap">
                <table>
                  <thead>
                    <tr>{s.table.columns.map((c) => <th scope="col">{c}</th>)}</tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map((row) => (
                      <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {s.bullets && (
              <ul class="points">
                {s.bullets.map((b) => (
                  <li>
                    {inlineParts(b).map((part) =>
                      'href' in part ? (
                        <a
                          href={part.href}
                          target={part.external ? '_blank' : undefined}
                          rel={part.external ? 'noopener' : undefined}
                        >
                          {part.label}
                        </a>
                      ) : 'bold' in part ? (
                        <strong>{part.bold}</strong>
                      ) : (
                        part.text
                      )
                    )}
                  </li>
                ))}
              </ul>
            )}
            {s.footnote && (
              <p class="footnote">
                {inlineParts(s.footnote).map((part) =>
                  'href' in part ? (
                    <a
                      href={part.href}
                      target={part.external ? '_blank' : undefined}
                      rel={part.external ? 'noopener' : undefined}
                    >
                      {part.label}
                    </a>
                  ) : 'bold' in part ? (
                    <strong>{part.bold}</strong>
                  ) : (
                    part.text
                  )
                )}
              </p>
            )}
          </section>
        ))}

        <section class="block">
          <h2>{t.faqTitle}</h2>
          <div class="faq">
            {t.faq.map((i) => (
              <details>
                <summary>
                  {i.q}
                  <span class="mark" aria-hidden="true"></span>
                </summary>
                <p>{i.a}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="block">
          <h2>{t.relatedTitle}</h2>
          <ul class="related">
            {related.map((c) => (
              <li>
                <a href={categoryPath(c, lang)}>{c.content[lang].title}</a>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </article>
    <CallQuote lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  /*
   * One measure the whole way down. The page is spec-heavy and several pages
   * carry no photography at all, so nothing here depends on an image being
   * present - the band below simply does not render when there is none.
   */
  .category {
    padding: 40px var(--pad-x) 80px;
    --measure: 760px;
  }
  .crumbs {
    font-size: 13.5px;
    color: var(--ink-muted);
    display: flex;
    gap: 10px;
    margin-bottom: 34px;
  }
  .crumbs a {
    font-weight: 600;
  }
  .crumbs,
  .lead,
  .detail,
  .media {
    max-width: var(--measure);
    margin-inline: auto;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: clamp(34px, 3.6vw, 48px);
    letter-spacing: -0.02em;
    line-height: 1.04;
    color: var(--navy);
    margin-bottom: 24px;
    text-wrap: pretty;
  }
  .body {
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--ink-soft);
    margin-bottom: 16px;
    text-wrap: pretty;
  }
  .specs {
    margin-top: 30px;
    background: var(--bg-soft);
    border: 1px solid var(--border-soft);
    border-radius: 12px;
    padding: 24px 28px;
  }
  .specs h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17px;
    color: var(--navy);
    margin-bottom: 12px;
  }
  .specs ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .specs li {
    position: relative;
    padding: 7px 0 7px 22px;
    font-size: 15px;
    color: var(--ink-soft);
  }
  .specs li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 14px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
  }
  .detail {
    margin-top: 56px;
  }
  .block + .block {
    margin-top: 44px;
  }
  .block h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(21px, 2.2vw, 26px);
    letter-spacing: -0.01em;
    color: var(--navy);
    margin-bottom: 14px;
    text-wrap: balance;
  }
  .tablewrap {
    overflow-x: auto;
    margin: 20px 0;
    border: 1px solid var(--border-soft);
    border-radius: 12px;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  thead th {
    background: var(--bg-soft);
    text-align: left;
    font-weight: 700;
    font-size: 13.5px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--navy);
    padding: 12px 16px;
    white-space: nowrap;
  }
  tbody th {
    text-align: left;
    font-weight: 700;
    color: var(--navy);
    white-space: nowrap;
  }
  tbody th,
  tbody td {
    padding: 12px 16px;
    vertical-align: top;
    color: var(--ink-soft);
    line-height: 1.55;
    border-top: 1px solid var(--border-soft);
  }
  .points {
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    position: relative;
    padding: 6px 0 6px 22px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 13px;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--orange);
  }
  .body strong,
  .points strong,
  .footnote strong {
    font-weight: 700;
    color: var(--navy);
  }
  .footnote {
    margin-top: 14px;
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--ink-muted);
  }
  .faq details {
    border-bottom: 1px solid var(--border-soft);
  }
  .faq details:first-child {
    border-top: 1px solid var(--border-soft);
  }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 16px 2px;
    font-size: 16px;
    font-weight: 600;
    color: var(--navy);
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq summary:hover {
    color: var(--orange);
  }
  .mark {
    position: relative;
    width: 14px;
    height: 14px;
    flex: none;
  }
  .mark::before,
  .mark::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    background: var(--orange);
  }
  .mark::before {
    width: 14px;
    height: 2px;
  }
  .mark::after {
    width: 2px;
    height: 14px;
    transition: transform 0.15s;
  }
  .faq details[open] .mark::after {
    transform: scaleY(0);
  }
  .faq details p {
    padding: 0 2px 18px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--ink-soft);
  }
  .related {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .related a {
    display: inline-block;
    padding: 10px 18px;
    border: 1px solid var(--border-soft);
    border-radius: 999px;
    background: var(--bg-soft);
    font-size: 15px;
    font-weight: 600;
    color: var(--navy);
  }
  .related a:hover {
    border-color: var(--orange);
    color: var(--orange);
  }
  /*
   * Fixed-ratio frames keep every page the same height, but the photograph is
   * contained rather than cropped - source images run from 0.75 to 1.78 and
   * cropping was cutting the banners in half. The residual space is filled by a
   * blurred, enlarged copy of the same photograph, which reads as intentional
   * and hides the soft edges of the weaker source images.
   */
  .media {
    display: grid;
    gap: 18px;
    margin-top: 40px;
  }
  .media.pair {
    grid-template-columns: 1fr 1fr;
  }
  .frame {
    position: relative;
    margin: 0 auto;
    aspect-ratio: var(--r);
    /* Bound the height so a portrait source cannot run a thousand pixels tall. */
    width: min(100%, calc(560px * var(--r)));
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg-soft);
    box-shadow: 0 18px 44px rgba(21, 38, 94, 0.16);
  }
  .media.pair .frame {
    width: 100%;
  }
  /*
   * Each frame holds two copies of the image: a blurred, enlarged one filling
   * the frame, and the real one contained on top. Nothing is ever cropped, and
   * sources whose proportions do not match the frame sit on a soft field of
   * their own colours rather than on empty grey.
   */
  .backdrop {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    filter: blur(18px) saturate(1.1) brightness(0.94);
    transform: scale(1.15);
  }
  .frame img {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
