---
import { Image } from 'astro:assets';
import { ui, type Lang } from '../i18n/ui';
import workshopImg from '../assets/workshop.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].about;
---

<section id="about" class="about">
  <div class="media">
    <Image src={workshopImg} alt={t.imgAlt} widths={[640, 1000, 1400]} sizes="(max-width: 900px) 100vw, 42vw" />
  </div>
  <div>
    <p class="kicker">{t.kicker}</p>
    <h2>{t.title}</h2>
    <p class="body">{t.p1}</p>
    <p class="body">{t.p2}</p>
    <div class="stats">
      {t.stats.map((s) => (
        <div>
          {'flag' in s && s.flag ? (
            <div class="flag-wrap">
              <div class="flag">
                <img src="/flag-cyprus.svg" alt={lang === 'el' ? 'Κύπρος' : 'Cyprus'} loading="lazy" />
              </div>
            </div>
          ) : (
            <div class="val">{'v' in s ? s.v : ''}</div>
          )}
          <div class="label">{s.l}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 56px;
    padding: 84px var(--pad-x);
    scroll-margin-top: 90px;
  }
  .media {
    border-radius: 14px;
    overflow: hidden;
    min-height: 360px;
    box-shadow: 0 20px 50px rgba(21, 38, 94, 0.16);
  }
  .media img {
    width: 100%;
    height: 100%;
    min-height: 360px;
    object-fit: cover;
    display: block;
  }
  h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 38px);
    color: var(--navy);
    line-height: 1.06;
    margin-bottom: 20px;
    text-wrap: pretty;
  }
  .kicker {
    margin-bottom: 14px;
  }
  .body {
    font-size: 16px;
    line-height: 1.68;
    color: var(--ink-soft);
    margin-bottom: 18px;
  }
  .body:last-of-type {
    margin-bottom: 30px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .val {
    font: 800 34px/1 var(--font-display);
    color: var(--navy);
  }
  .label {
    font-size: 13.5px;
    color: var(--ink-muted);
    margin-top: 7px;
  }
  .flag-wrap {
    display: flex;
    align-items: center;
    height: 34px;
  }
  .flag {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 0 0 2px var(--navy), 0 6px 14px rgba(21, 38, 94, 0.22);
  }
  .flag img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  @media (max-width: 900px) {
    .about {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    .media,
    .media img {
      min-height: 260px;
    }
  }
</style>
