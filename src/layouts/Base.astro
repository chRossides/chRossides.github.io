---
import '@fontsource/source-sans-3/400.css';
import '@fontsource/source-sans-3/500.css';
import '@fontsource/source-sans-3/600.css';
import '@fontsource/source-sans-3/700.css';
import '@fontsource/commissioner/700.css';
import '@fontsource/commissioner/800.css';
import '@fontsource/commissioner/900.css';
import '../styles/global.css';
import { site, telIntl, ui, type Lang } from '../i18n/ui';
import type { ImageMetadata } from 'astro';
import ogImage from '../assets/hero-flag.jpg';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path of this page, e.g. '/proionta/ethnikes-simaies/'. Defaults to the landing page. */
  path?: string;
  /** Path of this page's other-language twin. Defaults to the landing page. */
  altPath?: string;
  /**
   * Sharing image for this page. Falls back to the hero photograph, which is
   * also what the organisation structured data uses site-wide - that stays put
   * regardless, since it describes the business rather than the page.
   */
  image?: ImageMetadata;
}

const { lang } = Astro.props;
const t = ui[lang];
const path = Astro.props.path ?? (lang === 'el' ? '/' : '/en/');
const altPath = Astro.props.altPath ?? (lang === 'el' ? '/en/' : '/');
const pageTitle = Astro.props.title ?? t.meta.title;
const pageDescription = Astro.props.description ?? t.meta.description;
const shareImage = Astro.props.image ?? ogImage;
const canonical = new URL(path, site.domain).href;
const alternate = new URL(altPath, site.domain).href;
const xDefault = new URL(lang === 'el' ? path : altPath, site.domain).href;

const orgName = lang === 'el' ? 'Χαρ. Ρωσσίδης ΛΤΔ' : 'Charalambos Rossides LTD';
const orgAltName = lang === 'el' ? 'Charalambos Rossides LTD' : 'Χαρ. Ρωσσίδης ΛΤΔ';

function postalAddress(addr: typeof site.addressShop) {
  return {
    '@type': 'PostalAddress',
    streetAddress: lang === 'el' ? addr.street : addr.streetEn,
    postalCode: addr.postal,
    addressLocality: addr.city[lang],
    addressCountry: 'CY',
  };
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.domain}/#business`,
      name: orgName,
      alternateName: orgAltName,
      description: t.meta.description,
      url: site.domain,
      logo: new URL('/android-chrome-512x512.png', site.domain).href,
      image: new URL(ogImage.src, site.domain).href,
      foundingDate: '1938',
      areaServed: { '@type': 'Country', name: 'Cyprus' },
      sameAs: site.sameAs,
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: [telIntl(site.phoneShop), telIntl(site.mobileShop)],
          contactType: 'sales',
          name: site.contactPerson[lang],
          availableLanguage: ['el', 'en'],
        },
        {
          '@type': 'ContactPoint',
          telephone: [telIntl(site.phoneFactory), telIntl(site.mobileFactory)],
          contactType: 'sales',
          name: site.factoryPersons[lang],
          availableLanguage: ['el', 'en'],
        },
      ],
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${site.domain}/#store`,
      name: `${orgName} - ${lang === 'el' ? 'Κατάστημα' : 'Store'}`,
      parentOrganization: { '@id': `${site.domain}/#business` },
      url: site.domain,
      telephone: telIntl(site.phoneShop),
      address: postalAddress(site.addressShop),
      geo: { '@type': 'GeoCoordinates', latitude: site.geoShop.lat, longitude: site.geoShop.lng },
      hasMap: site.mapShop,
      image: new URL(ogImage.src, site.domain).href,
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${site.domain}/#factory`,
      name: `${orgName} - ${lang === 'el' ? 'Εργοστάσιο' : 'Factory'}`,
      parentOrganization: { '@id': `${site.domain}/#business` },
      url: site.domain,
      telephone: [telIntl(site.phoneFactory), telIntl(site.phoneFactory2)],
      address: postalAddress(site.addressFactory),
      geo: { '@type': 'GeoCoordinates', latitude: site.geoFactory.lat, longitude: site.geoFactory.lng },
      hasMap: site.mapFactory,
      image: new URL(ogImage.src, site.domain).href,
    },
  ],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang === 'el' ? 'en' : 'el'} href={alternate} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#15265E" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={new URL(shareImage.src, site.domain).href} />
    <meta property="og:image:width" content={String(shareImage.width)} />
    <meta property="og:image:height" content={String(shareImage.height)} />
    <meta property="og:locale" content={lang === 'el' ? 'el_GR' : 'en_GB'} />
    <meta property="og:site_name" content={lang === 'el' ? 'Χαρ. Ρωσσίδης ΛΤΔ' : 'Charalambos Rossides LTD'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={new URL(shareImage.src, site.domain).href} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
